# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform interactive GIS and geo-tracking features.
# Set this via the Secrets panel in AI Studio Settings (gear icon, top-right).
# Alternatively, use the free Maps Demo Key: https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_mcp_codeassist_v1_aistudio
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# ======================== LIVE JOB AGGREGATOR APIS (OPTIONAL) ========================
# Note: Remotive, The Muse, Arbeitnow, and Greenhouse/Lever/Ashby ATS endpoints work with zero keys.
# Add any of the keys below in AI Studio Settings > Secrets to unlock additional aggregators:
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# ======================== SLATE AI MULTI-PROVIDER KEYS (OPTIONAL) ========================
# Set these via AI Studio Settings > Secrets (or .env when running locally).
# Never commit real API keys.
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://127.0.0.1:11434
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ======================== NOTION WORKSPACE INTEGRATION (OPTIONAL) ========================
# Set NOTION_API_KEY in AI Studio Settings > Secrets (or local .env). Never expose to frontend.
NOTION_API_KEY=
NOTION_API_VERSION=2022-06-28

# ======================== CLAY JOB PIPELINE INTEGRATION (OPTIONAL) ========================
# Set these in AI Studio Settings > Secrets (or local .env). Never expose to frontend.
CLAY_WEBHOOK_URL=
CLAY_API_KEY=
CLAY_INGEST_SECRET=

# ======================== FIREBASE (Firestore persistence) ========================
# CLAY_OWNER_UID: Firebase Auth UID of the single owner account. External Clay
# webhooks (server-to-server, no browser ID token) are written under this user.
CLAY_OWNER_UID=
# FIREBASE_SERVICE_ACCOUNT_JSON: Full service-account JSON for unattended
# webhook writes and the one-time legacy JSON import. On Cloud Run the default
# application credentials are used automatically when this is unset.
FIREBASE_SERVICE_ACCOUNT_JSON=
